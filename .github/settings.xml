<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <!-- servers：只定义一个“GitHub Packages 的统一凭证” -->
    <servers>
        <server>
            <!-- 这个 id 需要和下面 mirrorOf 对应 -->
            <id>github</id>

            <!-- 用户名固定写你账号也行 -->
            <username>wenziyue1984</username>

            <!-- 密码统一读 GH_MAVEN_TOKEN（PAT） -->
            <password>${env.GH_MAVEN_TOKEN}</password>
        </server>
    </servers>

    <!-- mirrors：把所有 github packages 的仓库请求都“镜像”到同一个仓库入口 -->
    <mirrors>
        <mirror>
            <!-- 镜像的 id，必须等于 servers 里的 id，才能自动带上认证 -->
            <id>github</id>

            <!-- 镜像的目标地址：GitHub Packages 的 Maven 入口 -->
            <!-- 注意：这里不是某个具体仓库，而是统一入口 -->
            <url>https://maven.pkg.github.com/wenziyue1984/*</url>

            <!-- mirrorOf：匹配所有你 pom / profile 里配置的 GitHub repo id -->
            <!-- * 的意思是：所有仓库都走这个 mirror -->
            <mirrorOf>github-bom,github-auth-core,wenziyue-redis</mirrorOf>
        </mirror>
    </mirrors>


    <!-- profiles：定义一组“仓库下载策略” -->
    <profiles>
        <profile>
            <id>ci</id>

            <!-- repositories：依赖下载仓库 -->
            <repositories>
                <!-- 阿里云公共仓库：下载快 -->
                <repository>
                    <id>aliyun</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>

                <!-- Maven Central 兜底 -->
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>

                <!-- BOM 仓库 -->
                <repository>
                    <id>github-bom</id>
                    <url>https://maven.pkg.github.com/wenziyue1984/wenziyue-bom</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>

                <!-- auth-core 的 GitHub Packages 仓库 -->
                <repository>
                    <id>github-auth-core</id>
                    <url>https://maven.pkg.github.com/wenziyue1984/wenziyue-auth-core</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>

                <repository>
                    <id>github-redis</id>
                    <url>https://maven.pkg.github.com/wenziyue1984/wenziyue-redis-starter</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>

            </repositories>

            <!-- pluginRepositories：插件下载仓库（比如 maven-compiler-plugin 等） -->
            <pluginRepositories>
                <pluginRepository>
                    <id>aliyun</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <!-- activeProfiles：默认启用上面的 aliyun profile -->
    <activeProfiles>
        <activeProfile>ci</activeProfile>
    </activeProfiles>

</settings>