<!--
  这个 settings.xml 只服务于 CI / Release 的“构建”阶段。
  目的：把依赖下载源固定住（阿里云 + central），避免在不同网络/不同机器上表现不一致。

  注意：
  1) 这里没有 servers，因为我们暂时不做 deploy（不推 GitHub Packages）。
  2) 如果你以后要推包/推镜像，再单独搞 deploy-settings.xml 或加 servers。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              http://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>github-wenziyue-bom</id>
            <username>${env.GITHUB_ACTOR}</username>         <!-- 自动注入当前 GitHub 用户名 -->
            <password>${env.GITHUB_TOKEN}</password>         <!-- 自动注入 GITHUB_TOKEN，无需手动配置 -->
        </server>
    </servers>

    <!-- profiles：定义一组“仓库下载策略” -->
    <profiles>
        <profile>
            <id>aliyun</id>

            <!-- repositories：依赖下载仓库 -->
            <repositories>
                <!-- 阿里云公共仓库：下载快 -->
                <repository>
                    <id>aliyun</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>

                <!-- Maven Central 兜底 -->
                <repository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>

            <!-- pluginRepositories：插件下载仓库（比如 maven-compiler-plugin 等） -->
            <pluginRepositories>
                <pluginRepository>
                    <id>aliyun</id>
                    <url>https://maven.aliyun.com/repository/public</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
                <pluginRepository>
                    <id>central</id>
                    <url>https://repo.maven.apache.org/maven2</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </pluginRepository>
            </pluginRepositories>
        </profile>
    </profiles>

    <!-- activeProfiles：默认启用上面的 aliyun profile -->
    <activeProfiles>
        <activeProfile>aliyun</activeProfile>
    </activeProfiles>

</settings>