<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 从配置中读取变量 -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="blog-gateway-service"/>
    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="./.logs/gateway"/>
    <springProperty name="LOG_MAXFILESIZE" source="logback.filesize" defaultValue="50MB"/>
    <springProperty name="LOG_FILEMAXDAY" source="logback.filemaxday" defaultValue="7"/>
    <springProperty name="ServerIP" source="spring.cloud.client.ip-address" defaultValue="0.0.0.0"/>
    <springProperty name="ServerPort" source="server.port" defaultValue="0000"/>

    <contextName>${APP_NAME}</contextName>

    <!-- 彩色日志转换器（用于控制台） -->
    <conversionRule conversionWord="clr" converterClass="org.springframework.boot.logging.logback.ColorConverter"/>
    <conversionRule conversionWord="wex" converterClass="org.springframework.boot.logging.logback.WhitespaceThrowableProxyConverter"/>
    <conversionRule conversionWord="wEx" converterClass="org.springframework.boot.logging.logback.ExtendedWhitespaceThrowableProxyConverter"/>

    <!-- 控制台日志格式（彩色） -->
    <property name="CONSOLE_LOG_PATTERN"
              value="[${APP_NAME}:${ServerIP}:${ServerPort}] %clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%-5level){blue} %clr(${PID}){magenta} %clr([%thread]){orange} %clr(%logger{36}){cyan} - [traceId:%X{traceId:-}] %msg%n"/>

    <!-- 文件日志格式（无颜色） -->
    <property name="FILE_LOG_PATTERN"
              value="[${APP_NAME}-${ServerIP}-${ServerPort}] %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level ${PID} [%thread] %logger{36} - [traceId:%X{traceId:-}] %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件输出 - ERROR -->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAXFILESIZE}</maxFileSize>
            <maxHistory>${LOG_FILEMAXDAY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- 文件输出 - INFO -->
    <appender name="INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}-info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-info.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAXFILESIZE}</maxFileSize>
            <maxHistory>${LOG_FILEMAXDAY}</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- dev 环境更详细 -->
    <springProfile name="dev">
        <root level="DEBUG">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ERROR"/>
            <appender-ref ref="INFO"/>
        </root>
    </springProfile>

    <!-- 其它环境 -->
    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="STDOUT"/>
            <appender-ref ref="ERROR"/>
            <appender-ref ref="INFO"/>
        </root>
    </springProfile>


    <!-- ========================= -->
    <!-- 网关访问日志：单独一份文件 -->
    <!-- ========================= -->

    <!-- 访问日志格式：建议更短一点，便于 grep；也可以直接沿用 FILE_LOG_PATTERN -->
    <property name="ACCESS_LOG_PATTERN"
              value="[${APP_NAME}-${ServerIP}-${ServerPort}] %d{yyyy-MM-dd HH:mm:ss.SSS} %msg%n"/>

    <!-- 单独的 access.log（滚动策略和你现有 INFO/ERROR 保持一致） -->
    <appender name="ACCESS" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前文件名：固定叫 access.log -->
        <file>${LOG_PATH}/${APP_NAME}-access.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 每天一个文件，文件太大继续按 .%i 分片 -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}-access.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAXFILESIZE}</maxFileSize>
            <maxHistory>${LOG_FILEMAXDAY}</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>${ACCESS_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 把你代码里的 LoggerFactory.getLogger("ACCESS_LOG") 绑定到 ACCESS appender -->
    <!-- additivity=false：不向 root 传递，避免 access 日志混进 INFO/ERROR -->
    <logger name="ACCESS_LOG" level="INFO" additivity="false">
        <appender-ref ref="ACCESS"/>
    </logger>

</configuration>